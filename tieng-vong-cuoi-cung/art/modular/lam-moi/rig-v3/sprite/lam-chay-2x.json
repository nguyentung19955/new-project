  "buoc_chan_moi_chu_ky": 2,
  "ty_le_cham_dat_moi_chan": 0.375,
  "ghi_chu": "ở tốc độ này chân chịu lực đứng yên so với đất (không trượt)"
 },
 "giu_pha_khi_doi_toc_do": {
  "cach": "Phát theo QUÃNG ĐƯỜNG, không theo thời gian: giữ một biến pha ∈ [0,1) sống qua mọi khung. Mỗi bước logic: pha = (pha + |vx| / QUANG) mod 1, với vx = px logic/bước, QUANG = quang_duong_moi_chu_ky_px_logic. Khung = floor(pha × 32). Đổi tốc độ (tăng/giảm tốc, va tường) chỉ đổi lượng cộng → pha liên tục, không nhảy khung, chân không trượt ở MỌI tốc độ.",
  "ma_gia": "lam.pha = (lam.pha + Math.abs(pl.vx) / 83.660) % 1;  const k = Math.floor(lam.pha * 32);",
  "tuong_duong_theo_thoi_gian": "ms_moi_khung = 20 × 130.72 / |v (px logic/s)|",
  "vao_chay": "từ đứng yên: đặt pha = 0 (khung 0 = ủng gần chạm đất) hoặc giữ pha cũ nếu vừa chạy",
  "luu_y": "chọn khung trong bước logic 60 Hz (như game hiện tại), không theo số lần vẽ"
 },
 "hitbox": "Hitbox / va chạm / vùng ăn đòn lấy từ GAMEPLAY (hộp cố định của nhân vật trong game, ví dụ pl.w×pl.h hiện tại), KHÔNG theo bóng hình sprite đang nhún/vung tay. Sheet chỉ để vẽ.",
