  ],
  "chieu": "tăng dần = vẽ trước (xa)"
 },
 "visible_ghi_chu": "visible=false: không vẽ CHÍNH mảnh đó; ma trận vẫn tính, con vẫn vẽ. Ghi đè theo pose: pose.hien[ten] = true/false.",
 "lat_ngang": {
  "kieu": "toan_rig",
  "mo_ta": "Lật ngang toàn rig khi nhân vật quay trái: áp ma trận S(−1,1) quanh x = x gốc (P thân thế giới) SAU khi tính mọi ma trận (W = T(x0,0)·S(−1,1)·T(−x0,0)·M). Không đổi slot, thu_tu_phu, visible, góc cục bộ hay dấu gap trong dữ liệu: IK giải trong hệ chưa lật rồi mới lật. Đích khoá chân đưa vào IK phải ở hệ CHƯA lật (x_chua_lat = 2·x0 − x_man_hinh)."
 },
