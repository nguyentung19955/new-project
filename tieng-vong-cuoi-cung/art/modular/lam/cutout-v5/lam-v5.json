{
 "schema_version": "5.0.0",
 "phien_ban": "lam-cutout-v5",
 "quy_uoc_goc": "Toạ độ px ảnh/thế giới: x phải, y xuống. Góc độ, DƯƠNG = chiều kim đồng hồ trên màn hình, 0° = +x, 90° = xuống. huong_anh = hướng xương D−P trong ảnh (0 nếu không có D). goc_nghi = góc TƯƠNG ĐỐI (cục bộ) của hướng mảnh so với hướng cha; gốc (than) so với trục x thế giới. Hướng = hướng xương nếu có D, ngược lại = trục x ảnh. Pose: pose.goc[ten] = delta cộng vào goc_nghi. M_con = M_cha·T(gan)·R(goc_nghi+delta+huong_cha−huong_con)·S(ti_le)·T(−P). gan = điểm gắn trên ảnh CHA (px chưa scale); với chuỗi chi, gan = D của cha.",
 "don_vi": "px thế giới (Lam cao ~470 px).",
 "world_to_logic": 0.23829787234042554,
 "logic_cao_lam": 112,
 "the_gioi_cao_lam": 470,
 "ghi_chu_thiet_bi": "px thiết bị = px logic × devicePixelRatio của canvas thật (bài thử dùng 2,17 làm giả định, CHƯA đo trên máy thật).",
