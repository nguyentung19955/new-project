{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", ".firebaserc", "**/.*",
      "docs/**", "tools/**", "**/node_modules/**",
      "**/*.py", "**/*.md", "**/*.txt", "**/*.psd", "**/*.zip",
      "**/nguon/**", "**/*nguon*"
    ],
    "redirects": [ { "source": "/", "destination": "/game/", "type": 302 } ],
    "headers": [
      { "source": "**/*.@(js|json|html)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(png|webp|jpg|ogg|mp3|wav)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=3600" } ] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false }
  }
}
