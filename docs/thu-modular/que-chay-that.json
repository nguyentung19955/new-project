{
 "loai": "linh-khi-thu-modular-que",
 "phien_ban": 2,
 "dong_tac": "chạy THẬT (đo từ sprite), 8 khung, lặp",
 "nguon": "docs/anh-goc/zed/zed-v2-canonical.png HÀNG 3 (y 512–767), cột i = ô x (i−1)×256 … i×256. Cùng tấm và cùng tỉ lệ với dáng đứng phiên 1. Hàng game đang dùng (moi/03-chay-v4, 12 khung) là bản vẽ khác (bộ ninja tóc đen, cỡ khác) — không dùng ở đây.",
 "so_khung": 8,
 "giay_moi_khung": 0.075,
 "o": [
  256,
  256
 ],
 "goc_trong_o": [
  128,
  248
 ],
 "doi_o": "ô que = ô tấm gốc dời xuống 9 px (đường đất tấm y=239 → y=248); không co giãn, không dời ngang",
 "he_toa_do": "GỐC (0,0) = góc TRÊN-TRÁI của khung (ô 256×256). khop_px/neo_do: (x, y) điểm ảnh trong ô (ô i nằm ở x = (i−1)×256 trên que-chay-that.png và zed-chay-that-hang.png). khop_game: khung 48×48, chân [24,45], cùng tỉ lệ phiên 1 (1 px = 0.1314 điểm game). Góc: 0° sang phải, 90° xuống. \"goc\" = hông chiếu xuống đất.",
 "quy_uoc_trai_phai": "phải = phía GẦN người xem (vẽ trước thân), trái = phía XA (vẽ sau). Ở hàng này tay/chân KHÔNG đổi bên giữa các khung (sprite vẽ kiểu phi): chân phải = chân TRƯỚC (đặt xuống đất ở khung 1,2,5,7,8), chân trái = chân SAU (đá ngược lên); tay phải = nắm tay đưa trước ngực, tay trái = tay xa (ló dưới tay phải ở khung 1,2,7,8; vung ra sau lưng ở khung 3–6).",
 "cach_do": "Tự động (do-chay-that.py: tách màu tóc/da/đỏ → đỉnh đầu, cằm, tâm đầu, eo, nắm tay, mũi + cổ chân; vai/hông theo thân; khuỷu/gối IK) rồi soát bằng mắt trên ảnh ×4 có lưới, chỉnh tay trong que-chay-that.chinh-tay.json. nguon_khop từng khớp ghi rõ khớp nào chỉnh tay. Sai số ước ±3 px (±0.4 điểm game); gối/khuỷu nằm trong quần thụng, ống tay — vị trí ước theo dáng, sai số lớn hơn (±5 px).",
 "khoa_goc": {
  "than": "hong→co",
  "dau": "co→dinh_dau",
  "ttp": "vai_phai→khuyu_phai",
  "tdp": "khuyu_phai→co_tay_phai",
  "btp": "co_tay_phai→nam_tay_phai",
  "ttt": "vai_trai→khuyu_trai",
  "tdt": "khuyu_trai→co_tay_trai",
  "btt": "co_tay_trai→nam_tay_trai",
  "dp": "hong_phai→goi_phai",
