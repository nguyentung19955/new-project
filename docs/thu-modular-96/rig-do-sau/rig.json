   ],
   "vung": "back",
   "khop": "wristFront",
   "duong": [
    "shoulderFront"
   ],
   "phia": "sau",
   "nguong": 1.0,
   "khiDung": {
    "before": "body"
   },
   "note": "Cổ tay trước lùi ra sau đường dọc qua vai trước quá 1 điểm ảnh (tay vung ra sau lưng): mép trong (vùng back) của giáp cẳng tay + giáp bắp tay áp vào thân → vẽ dưới lớp body, thân che phần mép lấn vào thân. Không đúng thì dùng mặc định của mảnh (ngay dưới frontArm). Thử neck→hipCenter trước: khớp tay trước luôn ở sau đường đó (11–12/12 khung) nên không phân biệt được pha vung, đã bỏ."
  }
 ],
 "quyTacNote": "Điểm \"khop\" so với đường thẳng qua 2 khớp \"duong\" (kéo dài), tại cùng tung độ; \"duong\" chỉ 1 khớp = đường dọc qua khớp đó. phia \"sau\" = lệch về phía lưng quá \"nguong\" điểm ảnh. Đúng → vùng \"vung\" của các mảnh \"manh\" dùng lớp \"khiDung\", sai → lớp mặc định trong mảnh.",
