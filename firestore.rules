rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // mỗi người chơi chỉ đọc / ghi được bản lưu của chính mình
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.data.save.size() < 400000);
    }
  }
}
